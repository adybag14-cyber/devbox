HOST=0.0.0.0
PORT=8100
MCP_AUTH_MODE=none
PUBLIC_BASE_URL=
# Local open-server bridge for ChatGPT Web / browser-based clients.
# Only applies to local loopback requests when MCP_AUTH_MODE=none.
ENABLE_GATEWAY_BRIDGE=true
GATEWAY_BRIDGE_ORIGINS=https://chatgpt.com,https://chat.openai.com
MAX_TEXT_OUTPUT_CHARS=unlimited
# Hard safety ceiling for each command stdout/stderr field. Values above 65536 are clamped.
MAX_COMMAND_OUTPUT_CHARS=65536
MAX_MCP_TRANSFER_CHARS=unlimited
MCP_JSON_BODY_LIMIT=unlimited
DOCKER_COMMAND_TIMEOUT_MS=120000

# Runtime selection: auto, docker, or host
# - auto => docker on Windows, host on Termux/Linux/macOS
DEVBOX_RUNTIME_MODE=auto

DEVBOX_CONTAINER_NAME=chatgpt-devbox-runtime
DEVBOX_IMAGE_NAME=chatgpt-devbox-runtime:local
# In host mode this defaults to HOST_WORKSPACE_PATH
DEVBOX_WORKSPACE_PATH=
# Leave blank to default to <repo>/workspace
HOST_WORKSPACE_PATH=
# In docker mode this defaults to root; in host mode it defaults to the current user
DEVBOX_DEFAULT_USER=
DEVBOX_AUTO_START=true
# Optional allowlist for devbox_run_program. Host mode defaults to HOST_PROGRAM_ALLOWLIST; Docker uses a conservative runtime list.
DEVBOX_PROGRAM_ALLOWLIST=
# Host search backend: auto prefers native ripgrep and falls back to the JS walker; rg or js can force a backend.
HOST_SEARCH_BACKEND=auto
# Shared execution QoS. Light/heavy background jobs use the execution pool; passive watchers have a separate pool.
MCP_EXEC_MAX_CONCURRENT=6
MCP_EXEC_RESERVED_INTERACTIVE=1
MCP_EXEC_QUEUE_TIMEOUT_MS=15000
MCP_BACKGROUND_QUEUE_TIMEOUT_MS=300000
MCP_WATCH_MAX_CONCURRENT=4
MCP_EXEC_HEAVY_WEIGHT=2
# Detached job durability/output controls.
MCP_JOB_LOG_MAX_BYTES=33554432
MCP_JOB_LOG_ROTATIONS=2
MCP_JOB_HEARTBEAT_MS=5000
MCP_JOB_ORPHAN_STALE_MS=15000
MCP_JOB_RETENTION_HOURS=168
# No-process wait ceiling and capture fail-fast policy.
MCP_WAIT_MAX_SECONDS=300
SCREEN_CAPTURE_ATTEMPT_TIMEOUT_MS=8000
SCREEN_CAPTURE_RETRIES=1
SCREEN_CAPTURE_QUEUE_TIMEOUT_MS=5000
# Guardian diagnostic host-pressure sampling interval; telemetry only, not a repair trigger.
GUARDIAN_HOST_PRESSURE_SAMPLE_MS=60000
# Cache slow tool-version probes used by devbox_status.
DEVBOX_VERSION_CACHE_MS=120000

ENABLE_HOST_EXEC=true
# Leave blank to default to the workspace path or your shell home
HOST_DEFAULT_WORKDIR=
# Windows: leave blank to prefer PowerShell 7 (pwsh.exe) and fall back to Windows PowerShell 5.1.
# Set POWERSHELL_EXE to force a specific primary executable; the legacy 5.1 path remains the default fallback.
POWERSHELL_EXE=
POWERSHELL_FALLBACK_EXE=
# HOST_SHELL still overrides the general host shell. On Windows, blank means the resolved PowerShell executable above.
HOST_SHELL=
HOST_PROGRAM_ALLOWLIST=

# Leave blank to use the current Node executable
NODE_EXE=
# Optional lifecycle deadline. Blank = 180s for Windows/host mode and 900s for Docker mode.
# Set only when unusually slow startup/build preparation needs a different bounded deadline.
DEVBOX_STARTUP_TIMEOUT_SECONDS=
# Leave blank to default to <repo>/run/oauth-state.json
OAUTH_STATE_FILE_PATH=

CLOUDFLARED_CONTAINER_NAME=chatgpt-devbox-cloudflared
CLOUDFLARED_PUBLIC_HOSTNAME=
CLOUDFLARED_TUNNEL_TOKEN=
CLOUDFLARED_METRICS_URL=http://127.0.0.1:20241/metrics
# Cloudflare Edge address family: auto, 4, or 6. Keep auto unless diagnosing an IP-family path issue.
CLOUDFLARED_EDGE_IP_VERSION=auto
# Transport to Cloudflare Edge: auto, quic, or http2.
CLOUDFLARED_TRANSPORT_PROTOCOL=auto
# Windows named-tunnel source binding. "auto" selects the current physical IPv4 default-route adapter.
# An explicit DHCP address is preserved while assigned; if it becomes stale, startup resolves the new physical default-route IPv4.
CLOUDFLARED_EDGE_BIND_ADDRESS=auto
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_ACCESS_JWKS_URL=
