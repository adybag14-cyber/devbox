{
  "manifest_version": 3,
  "name": "Devbox Chrome Bridge",
  "version": "0.2.6",
  "description": "An independent Rust bridge for explicitly granted Chrome tabs.",
  "key": "",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging"
  ],
  "background": {
    "type": "module",
    "service_worker": "background.mjs"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Devbox Chrome Bridge"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
