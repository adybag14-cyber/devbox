{
  "name": "docker-chatgpt-devbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ChatGPT-facing MCP server for Docker or host-mode devbox execution, including Termux/Linux/macOS host tooling.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adybag14-cyber/devbox.git"
  },
  "bin": {
    "devbox": "./bin/devbox.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "devbox": "node ./bin/devbox.js",
    "guardian": "node ./scripts/devbox-guardian.mjs",
    "guardian:check": "node ./scripts/devbox-guardian.mjs --once --no-repair",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.28.0",
    "express": "5.1.0",
    "jose": "^6.1.0",
    "zod": "4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
